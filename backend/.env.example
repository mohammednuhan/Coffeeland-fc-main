# ===== REQUIRED =====
# Port the API listens on.
PORT=4000

# SQLite database, resolved relative to backend/prisma/schema.prisma
DATABASE_URL="file:../data/database.sqlite"

# JWT signing secret. The server REFUSES to start if this is missing,
# shorter than 16 characters, or left as the placeholder.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-in-production-to-a-long-random-string"

# Token lifetime (jose format, e.g. 15m, 24h, 7d)
JWT_EXPIRES_IN="7d"

# JWT algorithm is fixed to HS256 in code.

# ===== OPTIONAL =====
# production | development
NODE_ENV=production

# Comma-separated allowed origins for cross-origin API calls.
# Leave EMPTY when frontend and API share a domain (the recommended setup).
CORS_ORIGINS=""

# Enables POST /api/auth/register. Leave EMPTY to disable admin self-registration
# entirely (recommended — admins are created with `npm run db:seed`).
ADMIN_REGISTER_KEY=""

# Telegram registration delivery.
# 1. Message @BotFather, create a bot, copy the token.
# 2. Send /start to your bot once, then call getUpdates to read its chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID="7019536523"

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="20"
AUTH_RATE_LIMIT_MAX_REQUESTS="5"

# ===== SEED ADMIN =====
# Only used by `npm run db:seed`. Change before seeding any shared environment.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@coffeelandfc.com"
SEED_ADMIN_PASSWORD="change-this-before-seeding"