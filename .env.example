# ===== FRONTEND =====
# Host port to publish the site. Use 80 for a standard web server.
FRONTEND_PORT=3001

# ===== BACKEND =====
# Required. The backend refuses to start without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-in-production-to-a-long-random-string

JWT_EXPIRES_IN=7d

# Comma-separated allowed origins. Leave EMPTY for same-domain deployments.
CORS_ORIGINS=

# Leave EMPTY to disable admin self-registration.
ADMIN_REGISTER_KEY=

# Telegram — create a bot with @BotFather, send it /start, copy the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=7019536523

# ===== RATE LIMITING =====
RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_MAX_REQUESTS=5